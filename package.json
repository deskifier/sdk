{
  "name": "@deskifier/sdk",
  "version": "3.1.2",
  "description": "TypeScript SDK for building apps on the Deskifier desktop platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run check:parity",
    "docs:build": "typedoc",
    "check:parity": "tsc -p tsconfig.parity.json"
  },
  "keywords": [
    "deskifier",
    "electron",
    "desktop",
    "sdk",
    "bubble"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deskifier/sdk.git"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5",
    "typedoc": "^0.25.7",
    "typedoc-plugin-markdown": "^3.17.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.deskifier.com"
}
